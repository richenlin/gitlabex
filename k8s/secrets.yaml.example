---
# GitLabEx Secrets 配置文件示例
# 
# 重要提示:
# 1. 请复制此文件为 secrets.yaml: cp secrets.yaml.example secrets.yaml
# 2. 修改所有敏感信息的值为实际的生产环境配置
# 3. secrets.yaml 文件已被添加到 .gitignore，不会被提交到版本控制
# 4. 所有base64编码的值需要使用: echo -n "your-value" | base64
# 
# 使用方法:
#   kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: gitlabex-secrets
  namespace: gitlabex
type: Opaque
data:
  # PostgreSQL 配置
  # 值: gitlab
  postgres-user: Z2l0bGFi
  # 值: password123 (请修改为实际密码)
  postgres-password: cGFzc3dvcmQxMjM=
  
  # Redis 配置
  # 值: password123 (请修改为实际密码)
  redis-password: cGFzc3dvcmQxMjM=
  
  # GitLab 配置
  # 值: b75hZ0qcwLKD (请修改为实际密码)
  gitlab-root-password: Yjc1aFowcWN3TEtE
  # GitLab OAuth Client ID (需要手动配置后填写)
  gitlab-client-id: WVVVVV9DTEFOVABJRFBUT0xERVI=
  # GitLab OAuth Client Secret (需要手动配置后填写)
  gitlab-client-secret: WVVVVV9DTElFTlRfU0VDUkVUX1BMQUNFSE9MREVSAA==
  # GitLab System Token (需要手动配置后填写)
  gitlab-system-token: WVVVVV9TWVNURU1fVE9LRU5fUExBQ0VIT0xERVI=
  
  # MinIO 配置
  # 值: admin
  minio-root-user: YWRtaW4=
  # 值: password123 (请修改为实际密码)
  minio-root-password: cGFzc3dvcmQxMjM=
  
  # JWT Secret (用于生成JWT令牌)
  # 值: your-jwt-secret-key-change-in-production (请修改为随机生成的密钥)
  jwt-secret: eW91ci1qd3Qtc2VjcmV0LWtleS1jaGFuZ2UtaW4tcHJvZHVjdGlvbg==
  
  # 第三方API密钥 (用于外部系统集成)
  # 值: your-third-party-api-key (请修改为实际的API密钥)
  third-party-api-key: eW91ci10aGlyZC1wYXJ0eS1hcGkta2V5

---
# 生成base64编码值的命令示例:
# 
# # PostgreSQL密码
# echo -n "your-secure-password" | base64
# 
# # Redis密码
# echo -n "your-redis-password" | base64
# 
# # GitLab root密码
# echo -n "your-gitlab-root-password" | base64
# 
# # JWT Secret (建议生成随机字符串)
# openssl rand -base64 32
# 
# # 第三方API密钥
# echo -n "your-api-key" | base64
