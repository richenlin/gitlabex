# GitLabEx 后端服务配置文件
# 数据库和中间件配置

# ==================== 服务配置 ====================
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
DEBUG=true
GIN_MODE=debug

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接
DATABASE_URL=postgres://gitlabex:password123@localhost:5432/gitlabex?sslmode=disable

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300s

# ==================== Redis 配置 ====================
# Redis 缓存连接
REDIS_URL=redis://:password123@redis:6379

# Redis 连接池配置
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_CONN_MAX_IDLE_TIME=300s

# ==================== MinIO 对象存储配置 ====================
# MinIO 连接配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# MinIO 存储桶配置
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_TEMP=temp

# 文档存储配置
DOCUMENT_STORAGE_TYPE=minio
DOCUMENT_URL_EXPIRES=24h

# ==================== JWT 配置 ====================
# JWT 密钥配置
JWT_SECRET=gitlabex_super_secret_jwt_key_make_it_long_and_random_for_production_use
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==================== 文件上传配置 ====================
# 文件上传限制
MAX_UPLOAD_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx,csv,txt,md

# ==================== 邮件配置 ====================
# SMTP 邮件服务配置 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@gitlabex.com
SMTP_FROM_NAME=GitLabEx Platform

# ==================== 安全配置 ====================
# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# 速率限制配置
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ==================== 监控配置 ====================
# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
METRICS_ENABLED=true
METRICS_PORT=9090

# ==================== API密钥配置 ====================
# 第三方系统同步API密钥
SYNC_API_KEY=gitlabex_sync_api_key_2024_secure_change_in_production
THIRD_PARTY_API_KEY=gitlabex_third_party_api_key_2024

# ==================== 其他配置 ====================
# 时区设置
TZ=Asia/Shanghai

# 缓存配置
CACHE_TTL=3600s
CACHE_PREFIX=gitlabex:

# 任务队列配置
QUEUE_WORKERS=5
QUEUE_RETRY_ATTEMPTS=3
