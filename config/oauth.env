# GitLab OAuth 应用配置
# 由 configure-oauth.sh 脚本自动生成

GITLAB_URL=http://localhost:8081
REDIRECT_URI=http://localhost:3000/auth/gitlab/callback
APPLICATION_NAME="GitLabEx Education Platform"
SCOPES="api read_api openid"

# OAuth 应用凭据
GITLAB_CLIENT_ID=fc429dba2f2475aa020a6c25837a0bef48bc7ab227f4f0d420c40da263cd82c6
GITLAB_CLIENT_SECRET=2eb883179c458d593b91dfc94d47520b3d731576c4bd12626d84424bca637904

# GitLab 个人访问令牌 (用于数据初始化已经游客访问部分公开数据)
# 获取方式: 访问 http://localhost:8081/-/profile/personal_access_tokens
# 权限范围: api, read_api, read_user, read_repository, write_repository
GITLAB_ACCESS_TOKEN=
