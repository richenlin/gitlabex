# GitLab OAuth 应用配置
# 首次启动时需要手动配置这些值

GITLAB_URL=http://localhost:8081
REDIRECT_URI=http://localhost:3000/auth/gitlab/callback
APPLICATION_NAME="GitLabEx Education Platform"
SCOPES="api read_user openid"

# 需要手动配置以下值 (从GitLab Admin Area → Applications 获取)
GITLAB_CLIENT_ID=your_client_id_here
GITLAB_CLIENT_SECRET=your_client_secret_here
